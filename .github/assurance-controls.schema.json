{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/mars/.github/assurance-controls.schema.json",
  "title": "mars CI/CD assurance controls",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "soloMaintainer", "lifecycleStates", "controls"],
  "properties": {
    "$schema": {"const": "./assurance-controls.schema.json"},
    "schemaVersion": {"const": 1},
    "soloMaintainer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredHumanApprovals", "requiredTeams", "requiredCodeOwners"],
      "properties": {
        "requiredHumanApprovals": {"const": 0},
        "requiredTeams": {"const": false},
        "requiredCodeOwners": {"const": false}
      }
    },
    "lifecycleStates": {
      "type": "array",
      "const": ["configured", "enabled", "executed", "passing", "deferred", "blocked"]
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/control"}
    }
  },
  "$defs": {
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "tier", "trigger", "implementation", "evidence", "failurePolicy", "state"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "tier": {"enum": ["pull-request", "scheduled", "release", "preview"]},
        "trigger": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "implementation": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "failurePolicy": {"enum": ["block-merge", "block-release", "surface", "observe"]},
        "state": {"enum": ["configured", "enabled", "executed", "passing", "deferred", "blocked"]}
      }
    }
  }
}
