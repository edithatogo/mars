{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":configMigration",
    ":semanticCommits",
    ":automergePatch",
    ":automergeRequireAllStatusChecks",
    ":maintainLockFilesWeekly",
    ":separateMultipleMajorReleases",
    ":prConcurrentLimit10",
    ":prHourlyLimit2"
  ],
  "schedule": ["before 3am on Monday"],
  "timezone": "UTC",
  "enabledManagers": [
    "cargo",
    "devcontainer",
    "git-submodules",
    "github-actions",
    "gomod",
    "npm",
    "nuget",
    "pep621"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchUpdateTypes": ["major"],
      "labels": ["major-update", "breaking-change"],
      "semanticCommitType": "feat"
    },
    {
      "groupName": "pytest ecosystem",
      "matchPackageNames": [
        "pytest{/,}**",
        "pytest-{/,}**"
      ]
    },
    {
      "groupName": "ruff ecosystem",
      "matchPackageNames": ["ruff", "ruff-pre-commit"]
    },
    {
      "groupName": "scikit-learn ecosystem",
      "matchPackageNames": ["scikit-learn", "scipy", "numpy"]
    },
    {
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "automerge": true
    },
    {
      "matchManagers": ["pip_requirements", "pip_setup"],
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 3am on Monday"]
  },
  "rangeStrategy": "bump",
  "platformAutomerge": false,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "commitMessagePrefix": "chore(deps): ",
  "prBodyTemplate": "{{{header}}}{{{table}}}{{{notes}}}{{{changelog}}}{{{controls}}}",
  "labels": ["dependencies"]
}
